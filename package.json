{
  "name": "android-studio-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing Android SDK, emulator, adb, Gradle and project tooling to any MCP client (Claude, Cursor, Gemini CLI, Codex).",
  "type": "module",
  "bin": {
    "android-studio-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build && node scripts/parse-test.mjs && node scripts/http-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
